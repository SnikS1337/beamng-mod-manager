// Зерно фона прибавкой к цвету (2026-10-18). Плавные пятна света на 8 битах ложатся ступеньками в одну единицу яркости —
// кольцами. Прежнее зерно было слоем поверх (светлые и тёмные точки прозрачностью): на тёмном фоне тёмная точка меняла
// цвет меньше чем на единицу, зерно уходило только вверх, и ступеньки оставались видны. Здесь шум одинаковый вверх и вниз,
// ±amount/2 на любом фоне, по точке экрана на точку шума (tiles). Сборка: fxc /T ps_2_0 /E main.

sampler2D input : register(s0);
sampler2D noise : register(s1);   // плитка шума 128 × 128, ближайшая точка

float2 tiles : register(c0);      // сколько плиток шума по ширине и высоте (размер в точках экрана / 128)
float amount : register(c1);      // размах шума в долях единицы цвета

float4 main(float2 uv : TEXCOORD) : COLOR
{
    float4 c = tex2D(input, uv);
    float n = tex2D(noise, frac(uv * tiles)).r - 0.5;
    c.rgb = min(max(c.rgb + n * amount * c.a, float3(0.0, 0.0, 0.0)), float3(c.a, c.a, c.a));
    return c;
}
