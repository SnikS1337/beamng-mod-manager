<Project Sdk="Microsoft.NET.Sdk">

  <!-- Окно на WPF. Собирается только на Windows (GitHub Actions, windows.yml), логика вся в BeamModManager.Ui. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BeamModManager</AssemblyName>
    <RootNamespace>BeamModManager.App</RootNamespace>
    <Product>ModManager BeamNG</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- значок «Мод-куб из балок» (2026-10-17): exe, ярлык, панель задач. Собирает tools/icon/make_icon.py -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Шейдер преломления (DESIGN.md 3.2). Glass.ps собирает цель CompileGlassShader ниже; элемент без звёздочки
         остаётся в списке, даже если файла ещё нет. -->
    <Resource Include="Shaders\Glass.ps"/>
    <!-- линза капли для подписей (Controls/LensEffect.cs) -->
    <Resource Include="Shaders\Lens.ps"/>
    <!-- тот же значок у окна (Alt+Tab, панель задач) -->
    <Resource Include="app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeamModManager.Ui\BeamModManager.Ui.csproj" />
  </ItemGroup>

  <!-- Проверочная сборка самообновления (windows.yml, -p:SelfTestBuild=true): только она замечает BMM_TEST_UPDATE_FEED.
       Раньше отличали по номеру (третий от 1 до 49) — под это попали и настоящие 0.2.1, 0.3.1, а 0.3.0 нет (2026-10-18). -->
  <ItemGroup Condition="'$(SelfTestBuild)' == 'true'">
    <AssemblyMetadata Include="SelfTestBuild" Value="true" />
  </ItemGroup>

  <!-- Glass.fx -> Glass.ps и Lens.fx -> Lens.ps компилятором fxc из Windows SDK (есть на машинах GitHub Actions). Путь можно задать
       свойством FxcPath. Без fxc, но с готовым Glass.ps в репозитории сборка идёт дальше с ним.
       Цель стоит до BeforeBuild: ресурсы WPF (.g.resources) собираются позже, внутри CoreBuild. -->
  <ItemGroup>
    <GlassShader Include="Shaders\Glass.fx" Out="Shaders\Glass.ps"/>
    <GlassShader Include="Shaders\Lens.fx" Out="Shaders\Lens.ps"/>
  </ItemGroup>

  <Target Name="CompileGlassShader" BeforeTargets="BeforeBuild"
          Inputs="@(GlassShader);$(MSBuildProjectFullPath)" Outputs="@(GlassShader->'%(Out)')">
    <ItemGroup Condition="'$(FxcPath)' == ''">
      <_FxcCandidate Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.*\x64\fxc.exe"/>
    </ItemGroup>
    <PropertyGroup Condition="'$(FxcPath)' == ''">
      <_FxcList>@(_FxcCandidate)</_FxcList>
      <FxcPath Condition="'$(_FxcList)' != ''">$(_FxcList.Substring($([MSBuild]::Add($(_FxcList.LastIndexOf(';')), 1))))</FxcPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(FxcPath)') And !Exists('$(MSBuildProjectDirectory)\%(GlassShader.Out)')"
           Text="Не найден fxc.exe (Windows SDK) и нет готового %(GlassShader.Out). Установите Windows SDK или укажите путь: -p:FxcPath=..."/>
    <Message Condition="!Exists('$(FxcPath)')" Importance="normal"
             Text="fxc.exe не найден: используется готовый %(GlassShader.Out)"/>

    <Exec Condition="Exists('$(FxcPath)')" WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="&quot;$(FxcPath)&quot; /nologo /T ps_2_0 /E main /O3 /Fo &quot;%(GlassShader.Out)&quot; &quot;%(GlassShader.Identity)&quot;"
          IgnoreStandardErrorWarningFormat="true" CustomErrorRegularExpression="error X\d+" StandardOutputImportance="high"/>
  </Target>

</Project>
