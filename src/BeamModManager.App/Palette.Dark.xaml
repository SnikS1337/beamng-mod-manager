<!-- Тёмное оформление (как на доске «Гараж»). Ключи те же, что в Palette.Light.xaml: окно меняет словарь целиком,
     всё, что взято через DynamicResource, перекрашивается сразу (смену закрывает анимация раскрытия). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- текст -->
    <SolidColorBrush x:Key="Ink" Color="#F6F8FB"/>
    <SolidColorBrush x:Key="Ink2" Color="#E0FFFFFF"/>
    <SolidColorBrush x:Key="InkSoft" Color="#C2FFFFFF"/>
    <SolidColorBrush x:Key="Ink3" Color="#A3FFFFFF"/>
    <SolidColorBrush x:Key="InkHint" Color="#9EFFFFFF"/>
    <SolidColorBrush x:Key="Danger" Color="#FFB8B0"/>
    <SolidColorBrush x:Key="FocusRing" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowBack" Color="#1D2533"/>

    <!-- блоки данных правой панели темнее стекла: rgba(8,14,28,.34) (доска «Гараж»); строки настроек светлее стекла:
         rgba(255,255,255,.09) (доска «Настройки», как она отрисована) -->
    <SolidColorBrush x:Key="DataBlock" Color="#57080E1C"/>
    <SolidColorBrush x:Key="DataLine" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="RowFill" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="RowFillHover" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="RowOn" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="RowOnRim" Color="#D9FFFFFF"/>
    <LinearGradientBrush x:Key="RowRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.25"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- мягкое холодное свечение выбранного (0 0 22px rgba(170,205,255,.3)) -->
    <SolidColorBrush x:Key="SelGlow" Color="#AACDFF"/>
    <SolidColorBrush x:Key="SoftFill" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="NavHover" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="NavOn" Color="#33FFFFFF"/>

    <!-- кнопки -->
    <SolidColorBrush x:Key="PrimaryBack" Color="White"/>
    <SolidColorBrush x:Key="PrimaryInk" Color="#111111"/>
    <SolidColorBrush x:Key="SecBack" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="SecRim" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="SecHover" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="SecPress" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BadgeBack" Color="White"/>
    <SolidColorBrush x:Key="BadgeInk" Color="#111111"/>

    <!-- переключатели, сегменты, полоса прокрутки -->
    <SolidColorBrush x:Key="TrackOff" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="SegBack" Color="#57080E1C"/>
    <SolidColorBrush x:Key="SegHover" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SegOn" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="SegOnRim" Color="#59FFFFFF"/>
    <!-- дорожка сегментов в настройках светлее стекла (у фильтров — тёмная, SegBack) -->
    <SolidColorBrush x:Key="SetSegBack" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Thumb" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ThumbHover" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="ThumbDrag" Color="#A0FFFFFF"/>
    <SolidColorBrush x:Key="TileRim" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="TileRimHover" Color="#73FFFFFF"/>
    <SolidColorBrush x:Key="TileRimOn" Color="#E6FFFFFF"/>

    <LinearGradientBrush x:Key="TopFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#94080E1C" Offset="0"/>
        <GradientStop Color="#94080E1C" Offset="0.52"/>
        <GradientStop Color="#00080E1C" Offset="1"/>
    </LinearGradientBrush>
    <!-- свечение главной кнопки и тень стеклянных панелей: на тёмном — холодное свечение и глубокая тень -->
    <DropShadowEffect x:Key="PrimaryGlow" BlurRadius="30" ShadowDepth="0" Color="#AACDFF" Opacity="0.42" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="GlassShadow" BlurRadius="56" ShadowDepth="22" Direction="270" Color="#080C18" Opacity="0.38" RenderingBias="Performance"/>
</ResourceDictionary>
