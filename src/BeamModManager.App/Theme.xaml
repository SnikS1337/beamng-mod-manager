    <Geometry x:Key="IconGarage">M3.5,10 L11,4 L18.5,10 L18.5,18.5 L3.5,18.5 Z M8,18.5 L8,13 L14,13 L14,18.5</Geometry>
    <Geometry x:Key="IconUpdates">M18,11 A7,7 0 1 1 15.4,5.6 M18,3.6 L18,7.6 L14,7.6</Geometry>
    <Geometry x:Key="IconSearch">M15,10 A5,5 0 1 1 5,10 A5,5 0 1 1 15,10 Z M13.8,13.8 L18.5,18.5</Geometry>
    <Geometry x:Key="IconSettings">M17.47,9.69 L19.33,9.91 L19.33,12.09 L17.47,12.31 L16.50,14.65 L17.66,16.12 L16.12,17.66 L14.65,16.50 L12.31,17.47 L12.09,19.33 L9.91,19.33 L9.69,17.47 L7.35,16.50 L5.88,17.66 L4.34,16.12 L5.50,14.65 L4.53,12.31 L2.67,12.09 L2.67,9.91 L4.53,9.69 L5.50,7.35 L4.34,5.88 L5.88,4.34 L7.35,5.50 L9.69,4.53 L9.91,2.67 L12.09,2.67 L12.31,4.53 L14.65,5.50 L16.12,4.34 L17.66,5.88 L16.50,7.35 Z M14,11 A3,3 0 1 1 8,11 A3,3 0 1 1 14,11 Z</Geometry>
    <Geometry x:Key="IconCar">M3,14 L5.2,9 L16.8,9 L19,14 L19,17 L3,17 Z M3,14 L19,14 M6,17 L6,18.6 M16,17 L16,18.6 M6.5,9 L7.6,6.5 L14.4,6.5 L15.5,9</Geometry>
    <Geometry x:Key="IconMap">M3,6 L8,4 L14,6 L19,4 L19,16 L14,18 L8,16 L3,18 Z M8,4 L8,16 M14,6 L14,18</Geometry>
    <Geometry x:Key="IconSound">M4,9 L7,9 L11,5 L11,17 L7,13 L4,13 Z M14,8 A4,4 0 0 1 14,14 M16.5,5.5 A7.5,7.5 0 0 1 16.5,16.5</Geometry>
    <Geometry x:Key="IconScript">M8,6 L3,11 L8,16 M14,6 L19,11 L14,16 M12.4,4.5 L9.6,17.5</Geometry>
    <Geometry x:Key="IconBox">M4,7 L11,3.5 L18,7 L18,15 L11,18.5 L4,15 Z M4,7 L11,10.5 L18,7 M11,10.5 L11,18.5</Geometry>
    <Geometry x:Key="IconSnow">M5.5,0.5 L5.5,10.5 M1,3 L10,8 M1,8 L10,3</Geometry>
    <Geometry x:Key="IconMin">M1,5.5 L10,5.5</Geometry>
    <Geometry x:Key="IconMax">M3,1 L8,1 A2,2 0 0 1 10,3 L10,8 A2,2 0 0 1 8,10 L3,10 A2,2 0 0 1 1,8 L1,3 A2,2 0 0 1 3,1 Z</Geometry>
    <Geometry x:Key="IconRestore">M3,3 L8,3 L8,10 L1,10 L1,3 Z M3,3 L3,1 L10,1 L10,8 L8,8</Geometry>
    <Geometry x:Key="IconClose">M1.5,1.5 L9.5,9.5 M9.5,1.5 L1.5,9.5</Geometry>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <!-- Стекло (DESIGN.md 3.2, доска «Гараж»): копия сцены с лёгким размытием и преломлением у краёв (PART_Lens),
         подложка, блик сверху слева, кромка-блик по карте, контур 1 px, иней по краям и искры льда. Кромку, иней и искры
         окно считает под размер панели (Glass.cs). -->
    <Style TargetType="c:Glass">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Glass">
                    <Grid>
                        <Border x:Name="ShadowHost" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" Background="#0B1222">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="56" ShadowDepth="22" Direction="270" Color="#080C18" Opacity="0.38" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="PART_Clip" ClipToBounds="True">
                            <Grid x:Name="PART_Lens">
                                <Border ClipToBounds="True">
                                    <Rectangle x:Name="PART_Sample" IsHitTestVisible="False"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Tint}"/>
                        <Border x:Name="PART_Highlight" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.3,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0"/>
                                    <GradientStop Color="#0AFFFFFF" Offset="0.34"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="PART_Contour" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1"
                                BorderBrush="#1FFFFFFF" IsHitTestVisible="False"/>
                        <!-- кромка, иней и искры: Rectangle не просит места у раскладки (картинка растянула бы панель) -->
                        <Grid x:Name="PART_Deco" IsHitTestVisible="False" Opacity="0">
                            <Rectangle x:Name="PART_Rim"/>
                            <Rectangle x:Name="PART_Ice"/>
                            <Canvas x:Name="PART_Sparks"/>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Shadow" Value="False">
                            <Setter TargetName="ShadowHost" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Капля жидкого стекла: под активным пунктом левой панели и фильтра, на кнопках окна -->
    <LinearGradientBrush x:Key="DropFill" StartPoint="0.2,0" EndPoint="0.8,1">
        <GradientStop Color="#3DFFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.52"/>
        <GradientStop Color="#21FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DropRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9FFFFFF" Offset="0"/>
        <GradientStop Color="#8C6EC8FF" Offset="0.18"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.45"/>
        <GradientStop Color="#80FF6EC8" Offset="0.75"/>
        <GradientStop Color="#73FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Drop" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource DropFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DropRim}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="8" Direction="270" Color="#040814" Opacity="0.5" RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource FocusRing}" BorderThickness="3" CornerRadius="18" Margin="-2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт левой панели: иконка и подпись под ней (подпись видна всегда, DESIGN.md раздел 2) -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#BDFFFFFF"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Width" Value="70"/>
        <Setter Property="Height" Value="58"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" Margin="0,9,0,0">
                            <Path Style="{StaticResource Icon}" Data="{TemplateBinding Tag}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Content}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт фильтра в верхней панели: высота 30, активный белым 650 -->
    <Style x:Key="FilterItem" TargetType="Button">
        <Setter Property="Foreground" Value="#C7FFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"/>
                            <TextBlock Text="{Binding Count}" Opacity="0.7" FontWeight="SemiBold" Margin="5,0,0,0"
                                       Visibility="{Binding ShowCount, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главная кнопка: белая, тёмный текст, голубое свечение -->
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#111111"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="22" Background="White">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#AACDFF" Opacity="0.42" RenderingBias="Performance"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вторичная кнопка-таблетка в правой панели; нажатая сжимается до 97 % от центра, как главная (DESIGN.md 6) -->
    <Style x:Key="Secondary" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="19" Background="#24FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#38FFFFFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Текстовая ссылка («Отменить», «Понятно») -->
    <Style x:Key="Link" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="4,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Opacity" Value="0.8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка в капсуле окна: 44 × 36, сама прозрачная, подсветку даёт капля -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкая полоса прокрутки: светлый бегунок без кнопок -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="T" CornerRadius="4" Background="#40FFFFFF" Margin="2,0"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#80FFFFFF"/></Trigger>
                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#A0FFFFFF"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плашка на фото карточки: «Есть обновление», «Страница пропала», «Выключен» -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Background" Value="#CC0A101E"/>
        <Setter Property="BorderBrush" Value="#38FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,12,12,0"/>
    </Style>

    <!-- ═════ Настройки (DESIGN.md 5.1, доски «Настройки: …») ═════ -->

    <!-- Заголовок группы: «Стекло», «Фон», «Движение» -->
    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#EBFFFFFF"/>
        <Setter Property="Margin" Value="4,0,4,8"/>
    </Style>

    <!-- Пояснение под группой и в строках -->
    <Style x:Key="Note" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="#E0FFFFFF"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <!-- Строка-включатель: вся строка нажимается, справа дорожка 52 × 32; недоступная тускнеет, но остаётся на месте -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row" CornerRadius="18" Background="{StaticResource RowFill}" BorderBrush="{StaticResource RowRim}" BorderThickness="1" Padding="16,12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Right" Width="52" Height="32" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="16" Background="#38FFFFFF"/>
                                <Ellipse x:Name="Knob" Width="26" Height="26" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#060A16" Opacity="0.4" RenderingBias="Performance"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Note}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="Margin" Value="23,0,0,0"/>
                            <Setter TargetName="Track" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C6DFFF" Offset="0"/>
                                        <GradientStop Color="#8FBFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource RowFillHover}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка с выбором справа (сегменты, ползунок, счётчик): заголовок и пояснение слева -->
    <Style x:Key="OptionRow" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border CornerRadius="18" Background="{StaticResource RowFill}" BorderBrush="{StaticResource RowRim}" BorderThickness="1" Padding="16,12">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Header}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Note}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Сегменты: «Слабо | Средне | Сильно»; подложка и сами пункты -->
    <Style x:Key="SegmentBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="19"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Background" Value="#57080E1C"/>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#C2FFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" CornerRadius="15" Background="Transparent" Padding="14,6" Margin="1,0">
                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#3DFFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плитка готового набора: название и что в нём; выбранная светлее, с белой кромкой -->
    <Style x:Key="PresetTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" CornerRadius="16" Background="{StaticResource RowFill}" BorderBrush="{StaticResource RowRim}" BorderThickness="1" Padding="14,9">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="#E0FFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource RowFillHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="#D9FFFFFF"/>
                            <Setter TargetName="B" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плитка темы фона: образец самой темы (основа и два пятна), подпись внизу; выбранная — с белой кромкой -->
    <Style x:Key="ThemeTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="76"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border CornerRadius="16" Background="{Binding Palette, Converter={StaticResource ThemeSwatch}, ConverterParameter=base}"/>
                        <Border CornerRadius="16" Background="{Binding Palette, Converter={StaticResource ThemeSwatch}, ConverterParameter=blob0}"/>
                        <Border CornerRadius="16" Background="{Binding Palette, Converter={StaticResource ThemeSwatch}, ConverterParameter=blob2}"/>
                        <Border CornerRadius="16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00080E1C" Offset="0.35"/>
                                    <GradientStop Color="#99080E1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,10,9">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border x:Name="Rim" CornerRadius="16" BorderThickness="1" BorderBrush="#33FFFFFF"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rim" Property="BorderBrush" Value="#73FFFFFF"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Rim" Property="BorderBrush" Value="#E6FFFFFF"/>
                            <Setter TargetName="Rim" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт списка разделов настроек: таблетка 42 px, выбранный светлее и со свечением -->
    <Style x:Key="SettingsNav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#E0FFFFFF"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="settingsNav"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" CornerRadius="21" Background="Transparent" Padding="16,0">
                        <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#14FFFFFF"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Круглая кнопка счётчика «−» / «+» -->
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource Secondary}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="17" Background="#24FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#38FFFFFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ползунок: дорожка 6 px, белый круг 22 px со свечением -->
    <Style x:Key="ThinSlider" TargetType="Slider">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="SmallChange" Value="1"/>
        <Setter Property="LargeChange" Value="10"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="#4DFFFFFF" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="#CCFFFFFF" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="22">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#AACDFF" Opacity="0.5" RenderingBias="Performance"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пружина для подъёма карточки и наведения (DESIGN_MOTION 5): 0,5 с, упругость 0,15; длительность ×1,6 -->
    <m:SpringEase x:Key="Lift" Bounce="0.15"/>
    <m:SpringEase x:Key="Smooth" Bounce="0"/>
</ResourceDictionary>
