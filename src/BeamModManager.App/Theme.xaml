<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:BeamModManager.App.Controls"
                    xmlns:m="clr-namespace:BeamModManager.App.Motion">

    <!-- DESIGN.md 3.3–3.6: цвета, шрифт, иконки. Значения из итоговой доски «Гараж». -->
    <FontFamily x:Key="Font">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="Text" Color="#F6F8FB"/>
    <SolidColorBrush x:Key="Text2" Color="#E0FFFFFF"/>
    <SolidColorBrush x:Key="Text3" Color="#A3FFFFFF"/>
    <SolidColorBrush x:Key="Danger" Color="#FFB8B0"/>
    <SolidColorBrush x:Key="DataBlock" Color="#57080E1C"/>
    <SolidColorBrush x:Key="DataLine" Color="#17FFFFFF"/>
    <!-- строки и блоки на стекле (доска «ледяное стекло»): тёмная подложка rgba(8,14,28,.34) и тонкий свет сверху -->
    <SolidColorBrush x:Key="RowFill" Color="#57080E1C"/>
    <SolidColorBrush x:Key="RowFillHover" Color="#6E0C1428"/>
    <LinearGradientBrush x:Key="RowRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.25"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusRing" Color="#FFFFFF"/>

    <c:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    <c:NullToCollapsedConverter x:Key="NullToVisible" Invert="True"/>
    <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <c:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True"/>
    <c:PreviewBrushConverter x:Key="PreviewBrush"/>
    <c:PlaceholderIconConverter x:Key="PlaceholderIcon"/>
    <c:ChipDotConverter x:Key="ChipDot"/>
    <c:EnumToVisibilityConverter x:Key="EnumToVis"/>
    <c:EnumToBoolConverter x:Key="EnumToBool"/>
    <c:ThemeSwatchConverter x:Key="ThemeSwatch"/>

    <!-- Контурные иконки 22 px, линия 1.7 (DESIGN.md 3.6) -->
