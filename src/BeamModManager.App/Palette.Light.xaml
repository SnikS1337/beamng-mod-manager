<!-- Светлое оформление: светлое стекло, тёмный текст. Ключи те же, что в Palette.Dark.xaml. Подписи на фото карточек
     остаются белыми на своём затемнении в обоих оформлениях: карточка — это фото, а не стекло. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- текст -->
    <SolidColorBrush x:Key="Ink" Color="#141B2B"/>
    <SolidColorBrush x:Key="Ink2" Color="#D9141B2B"/>
    <SolidColorBrush x:Key="InkSoft" Color="#BF141B2B"/>
    <SolidColorBrush x:Key="Ink3" Color="#99141B2B"/>
    <SolidColorBrush x:Key="InkHint" Color="#8C141B2B"/>
    <SolidColorBrush x:Key="Danger" Color="#B4332A"/>
    <!-- янтарный только у предупреждений (треугольник с «!», DESIGN_COMPONENTS 4) -->
    <SolidColorBrush x:Key="Warn" Color="#8A5200"/>
    <SolidColorBrush x:Key="FocusRing" Color="#141B2B"/>
    <SolidColorBrush x:Key="WindowBack" Color="#E4E9F2"/>

    <!-- блоки и строки на стекле: светлая подложка и белая кромка сверху -->
    <SolidColorBrush x:Key="DataBlock" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="DataLine" Color="#1A0A1428"/>
    <SolidColorBrush x:Key="RowFill" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="RowFillHover" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="RowOn" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="RowOnRim" Color="#B3141B2B"/>
    <SolidColorBrush x:Key="SelGlow" Color="#7FA8E8"/>
    <LinearGradientBrush x:Key="RowRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#1A0A1428" Offset="0.3"/>
        <GradientStop Color="#1F0A1428" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SoftFill" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#290A1428"/>
    <SolidColorBrush x:Key="NavHover" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="NavOn" Color="#CCFFFFFF"/>

    <!-- меню карточки (DESIGN_COMPONENTS 3.9): плашка, не стекло -->
    <SolidColorBrush x:Key="MenuBack" Color="#F7FBFCFF"/>
    <SolidColorBrush x:Key="MenuRim" Color="#1F0A1428"/>
    <SolidColorBrush x:Key="MenuHover" Color="#140A1428"/>
    <SolidColorBrush x:Key="MenuLine" Color="#1A0A1428"/>

    <!-- кнопки: главная тёмная, вторичные белые -->
    <SolidColorBrush x:Key="PrimaryBack" Color="#1B2540"/>
    <SolidColorBrush x:Key="PrimaryInk" Color="White"/>
    <SolidColorBrush x:Key="SecBack" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="SecRim" Color="#260A1428"/>
    <SolidColorBrush x:Key="SecHover" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="SecPress" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="BadgeBack" Color="#1B2540"/>
    <SolidColorBrush x:Key="BadgeInk" Color="White"/>

    <!-- переключатели, сегменты, полоса прокрутки -->
    <SolidColorBrush x:Key="TrackOff" Color="#290A1428"/>
    <!-- дорожка фильтров на светлом стекле — лёгкая серая канавка, а не молочно-белая плашка (2026-10-17): стекло под ней видно -->
    <SolidColorBrush x:Key="SegBack" Color="#120A1428"/>
    <SolidColorBrush x:Key="SegHover" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="SegOn" Color="White"/>
    <SolidColorBrush x:Key="SegOnRim" Color="#1F0A1428"/>
    <SolidColorBrush x:Key="SetSegBack" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="Thumb" Color="#330A1428"/>
    <SolidColorBrush x:Key="ThumbHover" Color="#590A1428"/>
    <SolidColorBrush x:Key="ThumbDrag" Color="#800A1428"/>
    <SolidColorBrush x:Key="TileRim" Color="#260A1428"/>
    <SolidColorBrush x:Key="TileRimHover" Color="#590A1428"/>
    <SolidColorBrush x:Key="TileRimOn" Color="#D9141B2B"/>

    <LinearGradientBrush x:Key="TopFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8CE4E9F2" Offset="0"/>
        <GradientStop Color="#8CE4E9F2" Offset="0.52"/>
        <GradientStop Color="#00E4E9F2" Offset="1"/>
    </LinearGradientBrush>
    <!-- свечение главной кнопки и тень стеклянных панелей: на светлом фоне большое свечение и тень читались как грязное
         пятно вокруг кнопок (решено 2026-10-16) — здесь короткая мягкая тень снизу -->
    <DropShadowEffect x:Key="PrimaryGlow" BlurRadius="12" ShadowDepth="3" Direction="270" Color="#1B2540" Opacity="0.18" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="GlassShadow" BlurRadius="34" ShadowDepth="10" Direction="270" Color="#1B2540" Opacity="0.17" RenderingBias="Performance"/>
</ResourceDictionary>
