<Window x:Class="BeamModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BeamModManager.App.Controls"
        xmlns:g="clr-namespace:BeamModManager.Ui.Garage;assembly=BeamModManager.Ui"
        xmlns:u="clr-namespace:BeamModManager.Ui.Updates;assembly=BeamModManager.Ui"
        Title="ModManager BeamNG" Width="1440" Height="960" MinWidth="1000" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBack}"
        FontFamily="{StaticResource Font}" Foreground="{DynamicResource Ink}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" WindowStartupLocation="CenterScreen">

    <!-- Своя верхушка окна: полосы Windows нет, фон до самого верха (DESIGN_FLOWS раздел 2). Тянуть окно можно за верхние 64 px. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CardFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="White" BorderThickness="3" CornerRadius="29" Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка мода (DESIGN.md раздел 4, доска «Гараж»): фото на всю подложку, подпись внизу поверх затемнения -->
        <Style x:Key="Card" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Lift">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="Hover"/>
                                    <TranslateTransform x:Name="Pick"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- Слои, которые анимируются при наведении и выборе, кэшированы каждый сам по себе и лежат вне кэша
                                 карточки: меняется только их прозрачность и сдвиг, а это сводится к наложению готовых картинок.
                                 Раньше свечения лежали внутри общего кэша, и каждый кадр наведения заново считал три размытые тени,
                                 фото и подписи (и ещё раз в каждом стекле над карточкой) — анимация шла рывками. -->
                            <Border x:Name="GlowHover" CornerRadius="26" Background="#1D2533" Opacity="0" IsHitTestVisible="False">
                                <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#AACDFF" Opacity="0.24" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="GlowPick" CornerRadius="26" Background="#1D2533" Opacity="0" IsHitTestVisible="False">
                                <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="46" ShadowDepth="0" Color="#96C8FF" Opacity="0.34" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <!-- сама карточка (тень, фото, подписи) неподвижна внутри себя — кэш картинкой -->
                            <Grid x:Name="Body">
                            <Grid.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Grid.CacheMode>
                            <Border CornerRadius="26" Background="#1D2533">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="32" ShadowDepth="14" Direction="270" Color="#040814" Opacity="0.5" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- заглушка, когда картинки нет: значок типа мода, без нарисованных машин -->
                            <Border CornerRadius="26">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2A3446" Offset="0"/>
                                        <GradientStop Color="#1B2232" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Viewbox Width="56" Height="56" Opacity="0.42" Margin="0,0,0,40">
                                    <Path Data="{Binding Placeholder, Converter={StaticResource PlaceholderIcon}}" Stroke="White" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="22"/>
                                </Viewbox>
                            </Border>

                            <!-- фото: цветное и серое друг над другом; выключенный мод «засыпает» плавно (DESIGN_MOTION 3.1) -->
                            <Border CornerRadius="26">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource PreviewBrush}">
                                        <Binding Path="PreviewPath"/>
                                        <Binding Path="(c:CardGridPanel.InView)" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </Border.Background>
                            </Border>
                            <Grid x:Name="Sleep" Opacity="0" IsHitTestVisible="False" c:SleepFade.Awake="{Binding Enabled}">
                                <Border CornerRadius="26">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource PreviewBrush}" ConverterParameter="gray">
                                            <Binding Path="PreviewPath"/>
                                            <Binding Path="(c:CardGridPanel.InView)" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="26">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4D96C3EB" Offset="0"/>
                                            <GradientStop Color="#3378A5D7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <Border CornerRadius="26">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2E080E1C" Offset="0"/>
                                        <GradientStop Color="#00080E1C" Offset="0.26"/>
                                        <GradientStop Color="#00080E1C" Offset="0.5"/>
                                        <GradientStop Color="#A8080E1C" Offset="0.8"/>
                                        <GradientStop Color="#E6080E1C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Style="{StaticResource Chip}" Visibility="{Binding ChipText, Converter={StaticResource NullToCollapsed}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding Chip, Converter={StaticResource ChipDot}}"/>
                                    <Path x:Name="Snow" Data="{StaticResource IconSnow}" Stroke="White" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="11" Height="11" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <TextBlock Text="{Binding ChipText}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,14">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="Sub" Text="{Binding Subtitle}" FontSize="12.5" Foreground="#E0FFFFFF" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border CornerRadius="26" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#8CFFFFFF" Offset="0"/>
                                        <GradientStop Color="#38FFFFFF" Offset="0.12"/>
                                        <GradientStop Color="#1FFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            </Grid>
                            <!-- наведение: мягко проявляется светлая окантовка, видно, на какой карточке мышь -->
                            <Border x:Name="RimHover" CornerRadius="26" BorderThickness="1.5" IsHitTestVisible="False" Opacity="0">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#D9FFFFFF" Offset="0"/>
                                        <GradientStop Color="#99DCEBFF" Offset="0.5"/>
                                        <GradientStop Color="#73FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <!-- у выбранной кромка ярче -->
                            <Border x:Name="RimBright" CornerRadius="26" BorderThickness="1" IsHitTestVisible="False" Opacity="0">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C0FFFFFF" Offset="0"/>
                                        <GradientStop Color="#6BFFFFFF" Offset="0.12"/>
                                        <GradientStop Color="#29FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Chip}" Value="{x:Static g:ChipKind.Disabled}">
                                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Snow" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- выключили: мод «засыпает» — серый налёт; включили — оживает. Ведёт Controls/SleepFade (DESIGN_MOTION 3.1) -->
                            <DataTrigger Binding="{Binding SubtitleStrong}" Value="True">
                                <Setter TargetName="Sub" Property="Foreground" Value="White"/>
                                <Setter TargetName="Sub" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Y" To="-5" Duration="0:0:0.5" EasingFunction="{StaticResource Lift}"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Smooth}"/>
                                            <DoubleAnimation Storyboard.TargetName="RimHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Smooth}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.5" EasingFunction="{StaticResource Lift}"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Smooth}"/>
                                            <DoubleAnimation Storyboard.TargetName="RimHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Smooth}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- выбранная: без обводки, приподнята на 4 px, кромка ярче, мягкое холодное свечение (решено 2026-10-14) -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RimBright" Property="Opacity" Value="1"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Pick" Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.5" EasingFunction="{StaticResource Lift}"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowPick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Smooth}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Pick" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.5" EasingFunction="{StaticResource Lift}"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowPick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Smooth}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FactLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
        </Style>

        <!-- ═════ «Обновления» (доска «Обновления») ═════ -->

        <!-- Белая кнопка на фото-карточке: карточка — фото с затемнением в обоих оформлениях, кнопка всегда белая -->
        <Style x:Key="CardPrimary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="27,0"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="19" Background="White" Padding="{TemplateBinding Padding}">
                            <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#AACDFF" Opacity="0.34" RenderingBias="Performance"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Текстовая кнопка на фото-карточке: белая, без подчёркивания (на доске — просто слова) -->
        <Style x:Key="CardLink" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2,8"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="T" Text="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Прокрутка, как у сетки гаража: полоса поверх края, а не рядом -->
        <ControlTemplate x:Key="OverlayScroll" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,84,12,16"
                           Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
        </ControlTemplate>

        <!-- Карточка обновления (доска «Обновления»): фото слева уходит в тень, справа название, «1.0 → 1.5», пояснение и кнопки -->
        <DataTemplate x:Key="UpdateCard" DataType="{x:Type u:UpdateItem}">
            <Grid x:Name="Root" Height="196" Margin="0,0,0,20" SizeChanged="UpdCard_SizeChanged">
                <Grid.RenderTransform><TranslateTransform x:Name="Hover"/></Grid.RenderTransform>
                <!-- как у карточки гаража: свечение и кромка наведения — свои кэши вне кэша карточки, наведение их только
                     проявляет (без перерисовки фото, теней и подписей на каждом кадре) -->
                <Border x:Name="GlowHover" CornerRadius="26" Background="#1D2533" Opacity="0" IsHitTestVisible="False">
                    <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#AACDFF" Opacity="0.22" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
                <Grid x:Name="Card">
                <Grid.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Grid.CacheMode>
                <Border CornerRadius="26" Background="#1D2533">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="14" Direction="270" Color="#040814" Opacity="0.5" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
                <!-- фото: без картинки — спокойная заглушка; у пропавшей страницы серое, как у выключенного мода -->
                <Border x:Name="Photo" CornerRadius="26,0,0,26" HorizontalAlignment="Left" Width="560">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A3446" Offset="0"/>
                            <GradientStop Color="#1B2232" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Border CornerRadius="26,0,0,26" Visibility="{Binding Gray, Converter={StaticResource BoolToCollapsed}}">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource PreviewBrush}">
                                    <Binding Path="Card.PreviewPath"/>
                                </MultiBinding>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="26,0,0,26" Visibility="{Binding Gray, Converter={StaticResource BoolToVis}}" Opacity="0.85">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource PreviewBrush}" ConverterParameter="gray">
                                    <Binding Path="Card.PreviewPath"/>
                                </MultiBinding>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <!-- фото уходит в тень к тексту: прозрачно до 24 %, плотно с 36 % (fadeR на доске) -->
                <Border x:Name="Fade" CornerRadius="26">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00080E1C" Offset="0"/>
                            <GradientStop Color="#00080E1C" Offset="0.24"/>
                            <GradientStop Color="#DB080E1C" Offset="0.36"/>
                            <GradientStop Color="#F0080E1C" Offset="0.46"/>
                            <GradientStop Color="#F5080E1C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- кромка: ярче сверху, как у карточек гаража -->
                <Border CornerRadius="26" BorderThickness="1" IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8CFFFFFF" Offset="0"/>
                            <GradientStop Color="#38FFFFFF" Offset="0.12"/>
                            <GradientStop Color="#1FFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <StackPanel x:Name="Body" Margin="372,0,26,0" VerticalAlignment="Center" TextElement.Foreground="White">
                    <Border HorizontalAlignment="Left" CornerRadius="12" Height="24" Padding="10,0,11,0" Margin="0,0,0,8" Background="#CC0A101E"
                            BorderBrush="#38FFFFFF" BorderThickness="1" Visibility="{Binding Chip, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#FFB340" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Chip}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Card.Name}" FontSize="15" FontWeight="SemiBold" Opacity="0.92" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="26" FontWeight="Bold" LineHeight="29" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding OldVersion, Mode=OneWay}" FontWeight="Medium" Foreground="#C7FFFFFF" TextDecorations="Strikethrough"/><Run Text=" → " FontWeight="Medium" Foreground="#D6FFFFFF"/><Run Text="{Binding NewVersion, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Line1}" FontSize="13.5" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Line2}" FontSize="12.5" Foreground="#E0FFFFFF" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource CardPrimary}" Content="{Binding PrimaryLabel}" Tag="{Binding Primary}" Click="UpdAction_Click" Margin="0,2,22,2"
                                Visibility="{Binding PrimaryLabel, Converter={StaticResource NullToCollapsed}}"/>
                        <Button Style="{StaticResource CardLink}" Content="{Binding SecondLabel}" Tag="{Binding Second}" Click="UpdAction_Click" Margin="0,0,22,0"
                                Visibility="{Binding SecondLabel, Converter={StaticResource NullToCollapsed}}"/>
                        <Button Style="{StaticResource CardLink}" Content="{Binding ThirdLabel}" Tag="{Binding Third}" Click="UpdAction_Click" FontWeight="Medium" Foreground="#E0FFFFFF"
                                Visibility="{Binding ThirdLabel, Converter={StaticResource NullToCollapsed}}"/>
                    </WrapPanel>
                </StackPanel>
                </Grid>
                <Border x:Name="RimHover" CornerRadius="26" BorderThickness="1.5" BorderBrush="#99DCEBFF" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.5" EasingFunction="{StaticResource Lift}"/>
                                <DoubleAnimation Storyboard.TargetName="GlowHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Smooth}"/>
                                <DoubleAnimation Storyboard.TargetName="RimHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Smooth}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.5" EasingFunction="{StaticResource Lift}"/>
                                <DoubleAnimation Storyboard.TargetName="GlowHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Smooth}"/>
                                <DoubleAnimation Storyboard.TargetName="RimHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Smooth}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Строка сайта в панели «Проверка»: точка, название, состояние; «вы человек?» — «Открыть сайт», потом «Готово» -->
        <DataTemplate x:Key="SiteRowTemplate" DataType="{x:Type u:SiteRow}">
            <Border x:Name="Row" BorderBrush="{DynamicResource DataLine}" BorderThickness="0,1,0,0" Padding="14,0" MinHeight="42" ToolTip="{Binding Note}">
                <DockPanel VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#30D158" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding State}" FontSize="12.5" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Link}" Content="Открыть сайт" FontSize="12.5" Margin="8,0,0,0" Click="SiteOpen_Click"
                                Visibility="{Binding ShowOpen, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource Link}" Content="Готово" FontSize="12.5" Margin="8,0,0,0" Click="SiteDone_Click"
                                Visibility="{Binding AwaitingConfirm, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Dot}" Value="{x:Static u:SiteDot.Warn}">
                    <Setter TargetName="Dot" Property="Fill" Value="#FFB340"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Dot}" Value="{x:Static u:SiteDot.Off}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Ink3}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True" MouseLeftButtonDown="Root_MouseLeftButtonDown">

        <!-- ═════ Сцена: всё, что видно сквозь стекло ═════ -->
        <Grid x:Name="Scene">
            <Grid x:Name="Backdrop" IsHitTestVisible="False" ClipToBounds="True">
                <!-- основа: тёмный градиент темы (DESIGN.md 3.1, темы — Ui/Look/BackgroundThemes); цвета ставит и плавно меняет окно -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush x:Name="BaseBrush" StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Color="#101B33" Offset="0"/>
                            <GradientStop Color="#1B2236" Offset="0.55"/>
                            <GradientStop Color="#251C34" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- плывущая цветная полоса: подкрашивает основу (вместо «мягкого света» — прозрачность) -->
                <Border x:Name="GradeLayer" Opacity="0.30">
                    <Border.Background>
                        <LinearGradientBrush x:Name="Grade" StartPoint="0,0" EndPoint="1,0.36" SpreadMethod="Repeat">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="GradeMove"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#9E2F86E0" Offset="0"/>
                            <GradientStop Color="#85845BC8" Offset="0.25"/>
                            <GradientStop Color="#80F08A4A" Offset="0.5"/>
                            <GradientStop Color="#852BB8D6" Offset="0.75"/>
                            <GradientStop Color="#9E2F86E0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- вуаль сверху вниз: в тёмном оформлении затемняет (текст читается в любом месте), в светлом высветляет верх -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush x:Name="VeilBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#420C1220" Offset="0"/>
                            <GradientStop Color="#750C1220" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas x:Name="Lights"/>
                <Canvas x:Name="Flies"/>
            </Grid>

            <!-- прокрутка шире сетки на 44 px слева и 24 px справа (поля внутри): тени и свечение карточек у краёв не обрезаются -->
            <ScrollViewer x:Name="Scroller" Margin="72,0,336,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" PanningMode="VerticalOnly">
                <!-- полоса прокрутки поверх края сетки, а не рядом: иначе она отнимает ширину и колонок становится меньше -->
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,84,12,16"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                <StackPanel Margin="44,84,24,28">
                    <!-- самообновление: «Вышла новая версия» → «Обновить» → загрузка → перезапуск -->
                    <Border x:Name="UpdateBox" CornerRadius="20" MinHeight="44" Margin="0,0,0,12" Padding="18,6,10,6" DataContext="{x:Null}"
                            Visibility="{Binding Visible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3D6EB4FF" Offset="0"/>
                                <GradientStop Color="#268FD0FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <DockPanel VerticalAlignment="Center">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Secondary}" Height="32" MinWidth="110" Padding="14,0" Content="{Binding ActionLabel}" Click="UpdateAct_Click"
                                            Visibility="{Binding ActionLabel, Converter={StaticResource NullToCollapsed}}"/>
                                    <Button Style="{StaticResource Link}" Content="Позже" Margin="8,0,0,0" Click="UpdateLater_Click"
                                            Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="13.5" TextWrapping="Wrap"/>
                            </DockPanel>
                            <ProgressBar VerticalAlignment="Bottom" Height="3" Margin="0,0,8,-4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay, FallbackValue=0}"
                                         Foreground="{DynamicResource Ink2}" Background="{DynamicResource SoftFill}" BorderThickness="0"
                                         Visibility="{Binding Progress, Converter={StaticResource NullToCollapsed}}"/>
                        </Grid>
                    </Border>
                    <Border CornerRadius="20" MinHeight="40" Background="#33FFB340" Margin="0,0,0,12" Padding="18,8"
                            Visibility="{Binding StorageWarning, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding StorageWarning}" VerticalAlignment="Center" FontSize="13.5" TextWrapping="Wrap"/>
                    </Border>
                    <Border CornerRadius="20" Height="40" Background="{DynamicResource SoftFill}" Margin="0,0,0,20" Padding="18,0,10,0"
                            Visibility="{Binding ManyEnabledBanner, Converter={StaticResource NullToCollapsed}}">
                        <DockPanel VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Понятно" Click="DismissBanner_Click"/>
                            <TextBlock Text="{Binding ManyEnabledBanner}" VerticalAlignment="Center" FontSize="13.5"/>
                        </DockPanel>
                    </Border>
                    <ItemsControl x:Name="Cards" ItemsSource="{Binding Cards}" Focusable="False" KeyboardNavigation.TabNavigation="Once">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:CardGridPanel Loaded="CardPanel_Loaded"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type g:ModCard}">
                                <Button Style="{StaticResource Card}" Click="Card_Click" AutomationProperties.Name="{Binding Name}"
                                        AutomationProperties.HelpText="{Binding Subtitle}" ToolTipService.IsEnabled="False"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- «Обновления»: карточки во всю ширину, прокручиваются под верхней панелью и преломляются в её стекле -->
            <ScrollViewer x:Name="UpdScroller" Margin="72,0,336,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" PanningMode="VerticalOnly" Template="{StaticResource OverlayScroll}" Visibility="Collapsed">
                <StackPanel x:Name="UpdBody" Margin="44,84,24,28">
                    <!-- только видимые карточки (RowListPanel): шаг ряда — высота карточки 196 и отступ 20 из шаблона UpdateCard -->
                    <ItemsControl x:Name="UpdList" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource UpdateCard}" Focusable="False"
                                  KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:RowListPanel RowHeight="216"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- под верхней панелью карточки уходят в тень, чтобы подписи панели читались -->
            <Border x:Name="TopFade" Background="{DynamicResource TopFade}" IsHitTestVisible="False" VerticalAlignment="Top" Height="98" Margin="104,0,348,0">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="0.05"/>
                        <GradientStop Color="#FF000000" Offset="0.95"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
        </Grid>

        <!-- пустое состояние: приглашение к действию по центру области сетки (DESIGN_FLOWS раздел 4) -->
        <StackPanel x:Name="EmptyBox" Margin="116,84,360,0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding Empty, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding Empty.Title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Empty.Text}" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Style="{StaticResource Secondary}" Margin="0,16,0,0" HorizontalAlignment="Center" MinWidth="170" Padding="18,0"
                    Content="{Binding Empty.ActionLabel}" Click="EmptyAction_Click"
                    Visibility="{Binding Empty.ActionLabel, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>

        <!-- пустое состояние «Обновлений» -->
        <StackPanel x:Name="UpdEmptyBox" Margin="116,84,360,0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
            <TextBlock Text="{Binding Empty.Title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Empty.Text}" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Style="{StaticResource Secondary}" Margin="0,16,0,0" HorizontalAlignment="Center" MinWidth="170" Padding="18,0"
                    Content="{Binding Empty.ActionLabel}" Click="UpdEmpty_Click"
                    Visibility="{Binding Empty.ActionLabel, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>

        <!-- раздел ещё не сделан в этой сборке -->
        <StackPanel x:Name="SoonBox" Margin="116,84,360,0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="SoonTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Этот раздел появится в следующей сборке" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ═════ Стекло ═════ -->

        <!-- Левая панель: x 16, y 16, 84 × 284. Карточки под неё не заходят, поэтому сквозь неё видно только фон
             (Backdrop, а не вся сцена): наведение и прокрутка карточек не перерисовывают её стекло -->
        <c:Glass x:Name="Nav" Source="{Binding ElementName=Backdrop}" Corner="36" Blur="2" Tint="#700E182C"
                 Lens="30" Refraction="105" Brightness="0.78" Sparks="6" Seed="11"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" Width="84" Height="284"
                 WindowChrome.IsHitTestVisibleInChrome="True">
            <Canvas PreviewMouseLeftButtonDown="Nav_PreviewMouseDown" PreviewMouseLeftButtonUp="Nav_PreviewMouseUp" MouseLeave="Nav_MouseLeave">
                <!-- капля жидкого стекла (Controls/Droplet.cs): линза, объём, радужная кромка; в пути вытягивается, при нажатии сжимается -->
                <!-- капля шире пункта (76 из 84): подпись «Обновления» помещается внутри скругления, не наезжает на кромку -->
                <c:Droplet x:Name="NavDrop" Corner="27" Width="76" Height="58" Canvas.Left="4" Canvas.Top="0">
                    <c:Droplet.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NavDropScale"/>
                            <TranslateTransform x:Name="NavDropMove" Y="14"/>
                        </TransformGroup>
                    </c:Droplet.RenderTransform>
                </c:Droplet>
                <RadioButton x:Name="NavGarage" Style="{StaticResource NavItem}" Canvas.Left="7" Canvas.Top="14" Content="Моды" Tag="{StaticResource IconMods}"
                             c:NavGlyph.Fill="{StaticResource IconModsFill}" c:NavGlyph.ActiveFill="1"
                             IsChecked="True" Checked="Nav_Checked" ToolTip="Моды (Ctrl+1)"/>
                <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Canvas.Left="7" Canvas.Top="76" Content="Обновления" Tag="{StaticResource IconUpdates}"
                             c:NavGlyph.Fill="{StaticResource IconUpdatesFill}" c:NavGlyph.ActiveFill="0.34"
                             Checked="Nav_Checked" ToolTip="Обновления (Ctrl+2)"/>
                <!-- бейдж: пока «Обновления» не открывали, раз в 6 с от него расходится мягкое светлое кольцо (DESIGN.md 6 «Единый ритм») -->
                <Grid x:Name="UpdatesBadge" Canvas.Left="57" Canvas.Top="79" IsHitTestVisible="False"
                      Visibility="{Binding Filters[2].ShowCount, Converter={StaticResource BoolToVis}}">
                    <Border x:Name="BadgeRing" CornerRadius="9" Background="{DynamicResource BadgeBack}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="BadgeRingScale"/></Border.RenderTransform>
                    </Border>
                    <Border MinWidth="18" Height="18" CornerRadius="9" Background="{DynamicResource BadgeBack}" Padding="5,0">
                        <TextBlock Text="{Binding Filters[2].Count}" Foreground="{DynamicResource BadgeInk}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <RadioButton x:Name="NavSearch" Style="{StaticResource NavItem}" Canvas.Left="7" Canvas.Top="138" Content="Поиск" Tag="{StaticResource IconSearch}"
                             c:NavGlyph.Fill="{StaticResource IconSearchFill}" c:NavGlyph.ActiveFill="0.34"
                             Checked="Nav_Checked" ToolTip="Поиск (Ctrl+3)"/>
                <Rectangle Canvas.Left="22" Canvas.Top="200" Width="40" Height="1" Fill="{DynamicResource Divider}"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Canvas.Left="7" Canvas.Top="212" Content="Настройки" Tag="{StaticResource IconSettings}"
                             c:NavGlyph.Fill="{StaticResource IconSettingsFill}" c:NavGlyph.ActiveFill="1"
                             Checked="Nav_Checked" ToolTip="Настройки (Ctrl+,)"/>
            </Canvas>
        </c:Glass>

        <!-- Верх (решено 2026-10-17, «Островки»): над сеткой ряд от левой панели до правой (или до капсулы окна).
             Слева — крупный заголовок раздела прямо на фоне и строка под ним; стоит прокрутить список — он плавно сжимается
             в маленькую стеклянную капсулу. По центру ряда — островок: фильтры и круглая кнопка поиска; по нажатию (или Ctrl+F)
             островок перетекает в одну капсулу поиска. Без жидкого стекла — то же движение, стекло матовое. -->
        <Grid x:Name="TopRow" VerticalAlignment="Top" Margin="116,16,360,0" Height="52">
            <StackPanel x:Name="TitleBlock" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,-3,0,0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="TitleScale"/>
                        <TranslateTransform x:Name="TitleMove"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <TextBlock x:Name="SectionTitle" Text="Моды" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="CountLabel" Text="{Binding HeaderNote}" Foreground="{DynamicResource Ink2}" FontSize="13" Margin="1,-2,0,0"/>
            </StackPanel>

            <c:Glass x:Name="TitleCapsule" Source="{Binding ElementName=Backdrop}" Corner="20" Blur="3" Tint="#700E182C"
                     Lens="18" Refraction="60" Brightness="0.66"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" Height="40" Opacity="0" Visibility="Collapsed"
                     IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <c:Glass.RenderTransform><ScaleTransform x:Name="CapsuleScale" ScaleX="0.94" ScaleY="0.94"/></c:Glass.RenderTransform>
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CapsuleTitle" Text="Моды" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CapsuleCount" Text="{Binding HeaderCount}" FontSize="13" Foreground="{DynamicResource Ink3}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </c:Glass>

            <c:Glass x:Name="TopBar" Source="{Binding ElementName=Scene}" Corner="24" Blur="3" Tint="#700E182C"
                     Lens="22" Refraction="110" Brightness="0.60" Sparks="6" Seed="13"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" Height="48" Width="520"
                     RenderTransformOrigin="0.5,0.5" WindowChrome.IsHitTestVisibleInChrome="True">
                <c:Glass.RenderTransform><ScaleTransform x:Name="IslandScale"/></c:Glass.RenderTransform>
                <Grid x:Name="IslandBody" ClipToBounds="True" Margin="6,0">
                    <!-- фильтры и кнопка поиска -->
                    <StackPanel x:Name="FilterLayer" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="FilterBox" PreviewMouseLeftButtonDown="Filter_PreviewMouseDown" PreviewMouseLeftButtonUp="Filter_PreviewMouseUp" MouseLeave="Filter_MouseLeave" CornerRadius="21" Padding="3" Background="{DynamicResource SegBack}" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid>
                                <Canvas>
                                    <c:Droplet x:Name="FilterDrop" Corner="20" Height="40" Canvas.Top="-5" Width="60" Under="{DynamicResource SegBack}">
                                        <c:Droplet.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="FilterDropScale"/>
                                                <TranslateTransform x:Name="FilterDropMove" X="-3"/>
                                            </TransformGroup>
                                        </c:Droplet.RenderTransform>
                                    </c:Droplet>
                                </Canvas>
                                <ItemsControl x:Name="FilterList" ItemsSource="{Binding Filters}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type g:FilterItem}">
                                            <Button Style="{StaticResource FilterItem}" Click="Filter_Click" AutomationProperties.Name="{Binding Label}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Button x:Name="SearchButton" Style="{StaticResource IslandButton}" Tag="{StaticResource IconSearch}" FontSize="17" Margin="6,0,0,0"
                                Click="SearchButton_Click" ToolTip="Найти мод (Ctrl+F)" AutomationProperties.Name="Найти мод"/>
                    </StackPanel>
                    <!-- раскрытый поиск: одна капсула -->
                    <Grid x:Name="SearchLayer" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Ink2}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="22" Height="22" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Path.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Найти мод" Foreground="{DynamicResource InkHint}" FontSize="14" Margin="8,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" FontSize="14"
                                 VerticalAlignment="Center" AutomationProperties.Name="Найти среди установленных модов"
                                 TextChanged="SearchBox_TextChanged" LostKeyboardFocus="SearchBox_LostKeyboardFocus" FocusVisualStyle="{x:Null}"/>
                        <TextBlock x:Name="SearchNote" Grid.Column="2" Text="{Binding SearchNote}" Foreground="{DynamicResource Ink3}" FontSize="12.5"
                                   Margin="10,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button x:Name="SearchClose" Grid.Column="3" Style="{StaticResource IslandButton}" Tag="{StaticResource IconClose}" FontSize="11"
                                Click="SearchClose_Click" ToolTip="Закрыть поиск (Esc)" AutomationProperties.Name="Закрыть поиск"/>
                    </Grid>
                </Grid>
            </c:Glass>
        </Grid>


        <!-- ═════ Настройки (DESIGN.md 5.1): одна стеклянная панель, слева разделы, справа выбранный; всё применяется сразу ═════ -->
        <c:Glass x:Name="SettingsPanel" Source="{Binding ElementName=Scene}" Corner="32" Blur="4" Tint="#700E182C"
                 Lens="56" Refraction="144" Brightness="0.66" Sparks="12" Seed="16"
                 Margin="116,84,16,16" VerticalAlignment="Top" Visibility="Collapsed">
            <Grid x:Name="SettingsBody" Margin="20,24,8,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <RadioButton Style="{StaticResource SettingsNav}" Content="Внешний вид"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Appearance}"/>
                    <RadioButton Style="{StaticResource SettingsNav}" Content="Загрузка модов"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Downloads}"/>
                    <RadioButton Style="{StaticResource SettingsNav}" Content="Папки"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Folders}"/>
                    <RadioButton Style="{StaticResource SettingsNav}" Content="Обновления"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Updates}"/>
                    <RadioButton Style="{StaticResource SettingsNav}" Content="Сайты"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Sites}"/>
                </StackPanel>

                <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="Bold" Margin="4,4,0,18"/>

                        <!-- Внешний вид: две колонки, на узком окне одна (раскладку меняет окно) -->
                        <Grid x:Name="AppearanceGrid" Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Appearance}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AppearanceLeftCol" Width="*"/>
                                <ColumnDefinition x:Name="AppearanceRightCol" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="AppearanceLeft" Grid.Column="0" Margin="0,0,14,0">
                                <!-- «Как это выглядит» (доска «Настройки»): маленькая сцена — фон окна и картинки модов — под полоской
                                     жидкого стекла; полоска — настоящее стекло окна и сразу отвечает на переключатели -->
                                <TextBlock Style="{StaticResource GroupTitle}" Text="Как это выглядит"/>
                                <Grid x:Name="LookPreview" Height="172" Margin="0,0,0,18" SizeChanged="LookPreview_SizeChanged">
                                    <Grid x:Name="PvScene" IsHitTestVisible="False">
                                        <Rectangle x:Name="PvBack"/>
                                        <StackPanel x:Name="PvCards" Orientation="Horizontal" Margin="28,72,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <!-- как верх окна («островки»): крупный заголовок на фоне и островок с каплей «Все» и поиском -->
                                    <StackPanel Margin="24,16,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
                                        <TextBlock Text="Моды" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock x:Name="PvCount" Foreground="{DynamicResource Ink2}" FontSize="12"/>
                                    </StackPanel>
                                    <c:Glass x:Name="PreviewBar" Source="{Binding ElementName=PvScene}" Corner="23" Blur="5" Tint="#BD0C1426"
                                             Lens="24" Refraction="120" Brightness="1" Sparks="0" Seed="17"
                                             VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,18,22,0" Height="46" IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal" Margin="5,0,6,0" VerticalAlignment="Center">
                                            <Grid VerticalAlignment="Center">
                                                <c:Droplet Corner="17" Width="56" Height="34"/>
                                                <TextBlock Text="Все" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="Включённые" FontSize="13" Foreground="{DynamicResource InkSoft}" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Ink}" StrokeThickness="1.8" Stretch="Uniform"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </c:Glass>
                                    <Border CornerRadius="22" BorderBrush="{DynamicResource TileRim}" BorderThickness="1" IsHitTestVisible="False"/>
                                </Grid>

                                <TextBlock Style="{StaticResource GroupTitle}" Text="Готовые наборы"/>
                                <UniformGrid Columns="2" Margin="0,0,-8,0">
                                    <RadioButton Style="{StaticResource PresetTile}" GroupName="preset" Content="Красиво" Tag="жидкое стекло, живой фон, огоньки" IsChecked="{Binding IsBeautiful}"/>
                                    <RadioButton Style="{StaticResource PresetTile}" GroupName="preset" Content="Быстро" Tag="матовое стекло, фон стоит" IsChecked="{Binding IsFast}"/>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Note}" Text="{Binding PresetNote}" Margin="4,0,4,18"/>

                                <TextBlock Style="{StaticResource GroupTitle}" Text="Движение"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Анимации интерфейса" Tag="Капля-выбор, появление и подъём карточек."
                                          IsChecked="{Binding UiAnimations}" Margin="0,0,0,8"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Анимированный фон" Tag="По фону медленно плывут пятна света и цветная полоса."
                                          IsChecked="{Binding AnimatedBackground}" Margin="0,0,0,8"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Огоньки" Tag="Над фоном плавают светлые точки, на кромках стекла изредка вспыхивают искры."
                                          IsChecked="{Binding Fireflies}" Margin="0,0,0,18"/>
                            </StackPanel>
                            <StackPanel x:Name="AppearanceRight" Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Style="{StaticResource GroupTitle}" Text="Стекло"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Жидкое стекло" Tag="Края панелей преломляют фон, выбор — прозрачная капля. Выключено: матовое стекло и светлая плашка, движение то же."
                                          IsChecked="{Binding LiquidGlass}" Margin="0,0,0,18"/>

                                <TextBlock Style="{StaticResource GroupTitle}" Text="Оформление"/>
                                <HeaderedContentControl Style="{StaticResource OptionRow}" Header="Тема" Tag="Светлое стекло с тёмным текстом или тёмное." Margin="0,0,0,18">
                                    <Border Style="{StaticResource SegmentBox}" PreviewMouseLeftButtonDown="Mode_PreviewMouseDown">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Тёмная" IsChecked="{Binding ModeDark}"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Светлая" IsChecked="{Binding ModeLight}"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Как в Windows" IsChecked="{Binding ModeSystem}"/>
                                        </StackPanel>
                                    </Border>
                                </HeaderedContentControl>

                                <TextBlock Style="{StaticResource GroupTitle}" Text="Фон"/>
                                <ItemsControl ItemsSource="{Binding Themes}" Focusable="False" Margin="0,0,-8,18">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource ThemeTile}" GroupName="theme" IsChecked="{Binding IsSelected}"
                                                         AutomationProperties.Name="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <DockPanel x:Name="AppearanceFoot" Grid.Row="1" Grid.ColumnSpan="2" Margin="4,0,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Сбросить" Click="ResetLook_Click" VerticalAlignment="Top"
                                        ToolTip="Вернуть набор «Красиво»"/>
                                <TextBlock Style="{StaticResource Note}" MaxWidth="520" HorizontalAlignment="Left"
                                           Text="Если в Windows выключены эффекты анимации или прозрачности, программа учтёт это сама, даже когда здесь всё включено."/>
                            </DockPanel>
                        </Grid>

                        <!-- Загрузка модов -->
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Downloads}">
                            <CheckBox Style="{StaticResource Switch}" Content="Разрешить загрузку модов" IsEnabled="False" IsChecked="False"
                                      Tag="Включено: в программе появятся кнопки «Скачать» и «Установить». Выключено: менеджер показывает ваши моды и ведёт на страницу автора, а скачиваете вы сами."/>
                            <TextBlock Style="{StaticResource Note}" Margin="4,12,4,0"
                                       Text="Скачивание из программы ещё не готово, поэтому включатель пока недоступен. Платные моды не скачиваются никогда: вместо «Скачать» будет «Купить у автора»."/>
                        </StackPanel>

                        <!-- Папки -->
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Folders}">
                            <Border CornerRadius="18" Background="{DynamicResource RowFill}" BorderBrush="{DynamicResource RowRim}" BorderThickness="1" Padding="16,14" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Папка модов" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ModsFolderText}" FontSize="13.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Note}" Text="{Binding FolderNote}" Margin="0,2,0,0" Visibility="{Binding HasModsFolder, Converter={StaticResource BoolToVis}}"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource Secondary}" Content="Изменить" MinWidth="120" Padding="16,0" Margin="0,0,8,0" Click="PickFolder_Click"/>
                                        <Button Style="{StaticResource Secondary}" Content="Открыть в проводнике" Padding="16,0" Margin="0,0,8,0" Click="OpenFolder_Click"
                                                Visibility="{Binding HasModsFolder, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource Link}" Content="Найти автоматически" VerticalAlignment="Center" Click="AutoFolder_Click"
                                                Visibility="{Binding FolderIsManual, Converter={StaticResource BoolToVis}}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <HeaderedContentControl Style="{StaticResource OptionRow}" Header="Предупреждать о включённых модах" Margin="0,0,0,8"
                                                    Tag="Когда включено больше этого числа, над модами появляется строка: игра может грузиться дольше.">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Content="−" Click="LessWarn_Click" IsEnabled="{Binding CanLessWarn}" AutomationProperties.Name="Меньше"/>
                                    <TextBlock Text="{Binding WarnAboveText}" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Style="{StaticResource StepButton}" Content="+" Click="MoreWarn_Click" IsEnabled="{Binding CanMoreWarn}" AutomationProperties.Name="Больше"/>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource OptionRow}" Header="Копии прошлых версий"
                                                    Tag="Сколько прошлых версий каждого мода хранить при обновлении, чтобы можно было вернуться.">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Content="−" Click="LessBackups_Click" IsEnabled="{Binding CanLessBackups}" AutomationProperties.Name="Меньше"/>
                                    <TextBlock Text="{Binding KeepBackupsText}" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Style="{StaticResource StepButton}" Content="+" Click="MoreBackups_Click" IsEnabled="{Binding CanMoreBackups}" AutomationProperties.Name="Больше"/>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>

                        <!-- Обновления: программы (работает) и модов (появится вместе с разделом «Обновления») -->
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Updates}">
                            <TextBlock Style="{StaticResource GroupTitle}" Text="Программа"/>
                            <CheckBox Style="{StaticResource Switch}" Content="Проверять новую версию при запуске" Margin="0,0,0,8"
                                      Tag="Если вышла новая версия, над модами появится строка «Обновить». Обновляется только по вашей кнопке."
                                      IsChecked="{Binding CheckAppUpdates}"/>
                            <Border CornerRadius="18" Background="{DynamicResource RowFill}" BorderBrush="{DynamicResource RowRim}" BorderThickness="1" Padding="16,12" Margin="0,0,0,18">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Проверить сейчас" Padding="16,0" Margin="16,0,0,0"
                                                Click="CheckApp_Click" IsEnabled="{Binding CanUpdateApp}" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource Note}" Text="Новые версии берутся с GitHub, файл проверяется перед заменой." Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- что ответила проверка: та же плашка, что над модами -->
                                    <DockPanel x:Name="SettingsUpdateBox" Margin="0,12,0,0" DataContext="{x:Null}"
                                               Visibility="{Binding Visible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Height="32" Padding="14,0" Margin="12,0,0,0"
                                                Content="{Binding ActionLabel}" Click="UpdateAct_Click" Visibility="{Binding ActionLabel, Converter={StaticResource NullToCollapsed}}"/>
                                        <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="Моды"/>
                            <CheckBox Style="{StaticResource Switch}" Content="Проверять обновления модов при запуске" Margin="0,0,0,8"
                                      Tag="Программа сама смотрит на сайтах, не вышли ли новые версии ваших модов."
                                      IsChecked="{Binding AutoCheckOnStart}"/>
                            <HeaderedContentControl Style="{StaticResource OptionRow}" Header="Проверять ещё раз через" Tag="Если менеджер не закрывать, он сам проверит снова через это время. «Нет» — только при запуске и по кнопке." Margin="0,0,0,10">
                                <Border Style="{StaticResource SegmentBox}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="repeat" Content="Нет" IsChecked="{Binding RepeatOff}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="repeat" Content="3 ч" IsChecked="{Binding Repeat3}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="repeat" Content="6 ч" IsChecked="{Binding Repeat6}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="repeat" Content="12 ч" IsChecked="{Binding Repeat12}"/>
                                    </StackPanel>
                                </Border>
                            </HeaderedContentControl>
                            <TextBlock Style="{StaticResource Note}" Margin="4,0,4,0"
                                       Text="Проверяются моды, у которых указана страница на сайте. Найденное — в разделе «Обновления»."/>
                        </StackPanel>

                        <!-- Сайты -->
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Sites}">
                            <ItemsControl ItemsSource="{Binding Sites}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Switch}" Content="{Binding Name}" Tag="{Binding Text}" IsChecked="{Binding Enabled}" Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Note}" Margin="4,4,4,0"
                                       Text="Выключенный сайт не участвует в поиске и проверке обновлений. Сбой одного сайта не мешает остальным."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </c:Glass>

        <!-- узкое окно: правая панель выезжает поверх сетки, под ней затемнение; щелчок по нему закрывает панель -->
        <Border x:Name="Dim" Background="#7A060A14" Visibility="Collapsed" MouseLeftButtonDown="Dim_MouseDown"/>

        <!-- Правая панель: x 1096, y 64 (под капсулой кнопок окна), 328 × 880 -->
        <c:Glass x:Name="Inspector" Source="{Binding ElementName=Scene}" Corner="32" Blur="5" Tint="#800E182C"
                 Lens="56" Refraction="144" Brightness="0.70" Sparks="12" Seed="14"
                 HorizontalAlignment="Right" Width="328" Margin="0,64,16,16" Visibility="Collapsed">
            <c:Glass.RenderTransform><TranslateTransform x:Name="InspectorMove" X="344"/></c:Glass.RenderTransform>
            <Grid>
                <!-- содержимое панели; при смене выбора поверх него на миг лежит снимок прежнего (InspectorGhost) и тает (DESIGN_MOTION 3.5) -->
                <Grid x:Name="InspectorBody">
                    <StackPanel VerticalAlignment="Center" Margin="28,0" Visibility="{Binding Details, Converter={StaticResource NullToVisible}}">
                        <TextBlock Text="Выберите мод" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <DockPanel Margin="22,22,22,24" Visibility="{Binding Details, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <TextBlock Text="{Binding Details.PendingText}" Foreground="{DynamicResource Ink2}" FontSize="12.5" Margin="6,0,6,10" TextWrapping="Wrap"
                                       Visibility="{Binding Details.PendingText, Converter={StaticResource NullToCollapsed}}"/>
                            <UniformGrid Rows="1">
                                <Button x:Name="OpenPage" Style="{StaticResource Secondary}" Content="Открыть страницу" Margin="0,0,5,0" Click="OpenPage_Click"
                                        Visibility="{Binding Details.OpenPageLink, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource Secondary}" Content="{Binding Details.ToggleLabel}" Margin="5,0,0,0" Click="Toggle_Click"
                                        ToolTip="Пробел" Visibility="{Binding Details.ToggleLabel, Converter={StaticResource NullToCollapsed}}"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- прокрутка шире содержимого на поля панели: свечение главной кнопки не обрезается по бокам краем прокрутки -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="-22,-14,-22,0">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                    <Setter Property="Margin" Value="0,14,8,0"/>
                                </Style>
                            </ScrollViewer.Resources>
                            <StackPanel Margin="22,14,22,0">
                                <Grid Height="132">
                                    <Border CornerRadius="20">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2A3446" Offset="0"/>
                                                <GradientStop Color="#1B2232" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Viewbox Width="44" Height="44" Opacity="0.42">
                                            <Path Data="{Binding Selected.Placeholder, Converter={StaticResource PlaceholderIcon}}" Stroke="White" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="22"/>
                                        </Viewbox>
                                    </Border>
                                    <Border CornerRadius="20">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource PreviewBrush}">
                                                <Binding Path="Selected.PreviewPath"/>
                                            </MultiBinding>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="20" Visibility="{Binding Selected.Enabled, Converter={StaticResource BoolToCollapsed}}">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource PreviewBrush}" ConverterParameter="gray">
                                                <Binding Path="Selected.PreviewPath"/>
                                            </MultiBinding>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="20" BorderBrush="#33FFFFFF" BorderThickness="1"/>
                                </Grid>
                                <TextBlock Text="{Binding Details.Name}" FontSize="24" FontWeight="Bold" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="28"/>
                                <TextBlock Text="{Binding Details.Author}" Foreground="{DynamicResource Ink2}" Margin="0,3,0,0"
                                           Visibility="{Binding Details.Author, Converter={StaticResource NullToCollapsed}}"/>

                                <StackPanel Margin="0,18,0,0" Visibility="{Binding Details.ActionLabel, Converter={StaticResource NullToCollapsed}}">
                                    <Button Style="{StaticResource Primary}" Content="{Binding Details.ActionLabel}" Click="MainAction_Click"/>
                                    <TextBlock Text="{Binding Details.ActionHint}" FontSize="12.5" Foreground="{DynamicResource Ink2}" Margin="0,8,0,0"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Visibility="{Binding Details.ActionHint, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>

                                <Border CornerRadius="16" Background="{DynamicResource DataBlock}" BorderBrush="{DynamicResource RowRim}" BorderThickness="1" Margin="0,18,0,0">
                                    <ItemsControl ItemsSource="{Binding Details.Facts}" Focusable="False" AlternationCount="1000">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type g:Fact}">
                                                <Border x:Name="Row" BorderBrush="{DynamicResource DataLine}" BorderThickness="0,1,0,0" Padding="14,10">
                                                    <DockPanel>
                                                        <TextBlock Style="{StaticResource FactLabel}" Text="{Binding Label}"/>
                                                        <TextBlock Text="{Binding Value}" FontWeight="Medium" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                        <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
                <Image x:Name="InspectorGhost" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </c:Glass>

        <!-- Панель «Проверка» (доска «Обновления»): когда проверяли, кнопка, ход, сайты, автопроверка. Под капсулой окна, как правая панель -->
        <c:Glass x:Name="CheckPanel" Source="{Binding ElementName=Backdrop}" Corner="32" Blur="5" Tint="#800E182C"
                 Lens="56" Refraction="144" Brightness="0.70" Sparks="10" Seed="18"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Width="328" Margin="0,64,16,16" Visibility="Collapsed">
            <StackPanel x:Name="CheckBody" Margin="22,24,22,22">
                <TextBlock Text="Проверка" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding CheckText}" FontSize="13" Foreground="{DynamicResource Ink2}" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="18"/>
                <Button Style="{StaticResource Primary}" Content="{Binding CheckButton}" Margin="0,16,0,0" Click="CheckNow_Click"
                        ToolTip="Проверить обновления (F5)"/>
                <StackPanel Margin="2,12,2,0" Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsed}}">
                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding ProgressValue, Mode=OneWay}"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="12.5" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="Сайты" Foreground="{DynamicResource Ink2}" Margin="4,18,4,8"/>
                <Border CornerRadius="16" Background="{DynamicResource RowFill}" BorderBrush="{DynamicResource RowRim}" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding Sites}" ItemTemplate="{StaticResource SiteRowTemplate}" Focusable="False" AlternationCount="1000"/>
                </Border>
                <CheckBox Style="{StaticResource MiniSwitch}" Content="Проверять при запуске" IsChecked="{Binding AutoCheckOnStart}" Margin="4,16,2,0"/>
                <TextBlock Style="{StaticResource Note}" Text="{Binding AutoNote}" Margin="4,12,4,0"/>
            </StackPanel>
        </c:Glass>

        <!-- «Указать страницу» / «Найти замену» (DESIGN_FLOWS 6.4, 6.5): затемнение и стеклянная плашка по центру -->
        <Grid x:Name="BindLayer" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Background="#8C060A14" MouseLeftButtonDown="BindDim_MouseDown"/>
            <c:Glass x:Name="BindPanel" Source="{Binding ElementName=Scene}" Corner="32" Blur="6" Tint="#B80E182C"
                     Lens="48" Refraction="120" Brightness="0.66" Sparks="6" Seed="21"
                     Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                     KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <StackPanel x:Name="BindBody" Margin="26,24,26,24">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="88" Height="60" CornerRadius="14" Margin="0,0,16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2A3446" Offset="0"/>
                                    <GradientStop Color="#1B2232" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border CornerRadius="14" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource PreviewBrush}">
                                        <Binding Path="Card.PreviewPath"/>
                                    </MultiBinding>
                                </Border.Background>
                            </Border>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Card.Name}" Foreground="{DynamicResource Ink2}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Note}" Text="{Binding Lead}" Margin="2,16,2,12" FontSize="13"/>
                    <Grid>
                        <TextBox x:Name="BindLink" Style="{StaticResource GlassField}" Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="BindLink_TextChanged" AutomationProperties.Name="Ссылка на страницу мода"/>
                        <TextBlock x:Name="BindLinkHint" Text="https://www.modland.net/…" Foreground="{DynamicResource InkHint}" FontSize="13.5" Margin="16,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock x:Name="BindLinkNote" Text="{Binding LinkNote}" FontSize="12.5" Margin="4,6,4,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Ink2}" Visibility="{Binding LinkNote, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="Похожие на сайтах" Margin="4,18,4,8"/>
                    <TextBlock Style="{StaticResource Note}" Text="{Binding SearchNote}" Margin="4,0,4,8"
                               Visibility="{Binding SearchNote, Converter={StaticResource NullToCollapsed}}"/>
                    <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type u:PageSuggestion}">
                                <RadioButton Style="{StaticResource PickRow}" GroupName="bindPick" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="BindPick_Click">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource Ink2}" FontWeight="SemiBold" Text="{Binding Site}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource Ink2}" Margin="0,2,0,0"
                                                   Visibility="{Binding Details, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{Binding ApplyLabel}" Padding="26,0" MinWidth="210"
                                IsEnabled="{Binding CanApply}" Click="BindApply_Click"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Отмена" Margin="0,0,16,0" VerticalAlignment="Center" Click="BindCancel_Click"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource Link}" Content="Не проверять этот мод" VerticalAlignment="Center" Click="BindDecline_Click"
                                Visibility="{Binding Replacing, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                </StackPanel>
            </c:Glass>
        </Grid>

        <!-- Капсула кнопок окна 132 × 36 в правом верхнем углу; при наведении появляется капля, под «Закрыть» красная -->
        <!-- сквозь капсулу виден только фон: под ней край верхней тени, карточки там почти не видны, а капля на каждом шаге
             перерисовывала бы под собой всю сцену с карточками -->
        <c:Glass x:Name="Caption" Source="{Binding ElementName=Backdrop}" Corner="18" Blur="4" Tint="#700E182C"
                 Lens="18" Refraction="0" Brightness="0.78"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Width="132" Height="36"
                 WindowChrome.IsHitTestVisibleInChrome="True" MouseLeave="Caption_MouseLeave"
                 PreviewMouseLeftButtonDown="Caption_PreviewMouseDown" PreviewMouseLeftButtonUp="Caption_PreviewMouseUp">
            <Grid>
                <Canvas>
                    <!-- капля на 3 px меньше капсулы со всех сторон: в пути и на перелёте она не наезжает на блик кромки капсулы
                         (раньше край капли резал светлую линию сверху — «артефакт сверху капли») -->
                    <c:Droplet x:Name="CapDrop" Corner="15" Width="40" Height="30" Canvas.Top="3" Opacity="0">
                        <c:Droplet.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CapDropScale" ScaleX="0.6" ScaleY="0.6"/>
                                <TranslateTransform x:Name="CapDropMove" X="2"/>
                            </TransformGroup>
                        </c:Droplet.RenderTransform>
                    </c:Droplet>
                </Canvas>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMin}" Click="Min_Click" MouseEnter="CapButton_MouseEnter"
                            AutomationProperties.Name="Свернуть" ToolTip="Свернуть"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMax}" Click="Max_Click" MouseEnter="CapButton_MouseEnter"
                            AutomationProperties.Name="Развернуть" ToolTip="Развернуть"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Tag="{StaticResource IconClose}" Click="Close_Click" MouseEnter="CapButton_MouseEnter"
                            AutomationProperties.Name="Закрыть" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>
        </c:Glass>

        <!-- Тост: что сделано и «Отменить» -->
        <c:Glass x:Name="ToastBox" Source="{Binding ElementName=Scene}" Corner="24" Blur="6" Tint="#B30E182C"
                 Lens="24" Refraction="60" Brightness="0.70"
                 VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="116,0,360,28" Height="48" Padding="20,0,12,0"
                 Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Toast.Text}" FontSize="13.5" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Link}" Content="Отменить" Margin="14,0,0,0" Click="Undo_Click"
                        Visibility="{Binding Toast.CanUndo, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </c:Glass>

        <!-- смена оформления: кадр прежнего вида поверх всего, он раскрывается кругом от места нажатия (MainWindow.Reveal) -->
        <!-- смена оформления: вуаль цвета нового фона расходится кругом от места нажатия (без снимка окна — он долгий) -->
        <Rectangle x:Name="ModeVeil" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</Window>
