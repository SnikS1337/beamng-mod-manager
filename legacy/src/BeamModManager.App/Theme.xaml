<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:BeamModManager.App.Controls"
                    xmlns:m="clr-namespace:BeamModManager.App.Motion">

    <!-- DESIGN.md 3.3–3.6: цвета, шрифт, иконки. Значения из итоговой доски «Гараж». -->
    <FontFamily x:Key="Font">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- цвета оформления — в Palette.Dark.xaml и Palette.Light.xaml (берутся через DynamicResource) -->

    <c:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    <c:NullToCollapsedConverter x:Key="NullToVisible" Invert="True"/>
    <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <c:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True"/>
    <c:PreviewBrushConverter x:Key="PreviewBrush"/>
    <c:PlaceholderIconConverter x:Key="PlaceholderIcon"/>
    <c:ChipDotConverter x:Key="ChipDot"/>
    <c:EnumToVisibilityConverter x:Key="EnumToVis"/>
    <c:EnumToBoolConverter x:Key="EnumToBool"/>
    <c:ThemeSwatchConverter x:Key="ThemeSwatch"/>

    <!-- Контурные иконки 22 px, линия 1.7 (DESIGN.md 3.6) -->
    <!-- «Моды»: сетка карточек (раздел про все моды, не только машины) -->
    <!-- значки левой панели (решено 2026-10-17): «Моды» — мягкие плитки, «Обновления» и «Поиск» — как были, «Настройки» —
         ползунки стоймя. Только контур; у выбранного линия толще (NavGlyph; заливки убраны после боя 2026-10-17) -->
    <Geometry x:Key="IconMods">M6,4.5 L8.5,4.5 A1.5,1.5 0 0 1 10,6 L10,8.5 A1.5,1.5 0 0 1 8.5,10 L6,10 A1.5,1.5 0 0 1 4.5,8.5 L4.5,6 A1.5,1.5 0 0 1 6,4.5 Z M13.5,4.5 L16,4.5 A1.5,1.5 0 0 1 17.5,6 L17.5,8.5 A1.5,1.5 0 0 1 16,10 L13.5,10 A1.5,1.5 0 0 1 12,8.5 L12,6 A1.5,1.5 0 0 1 13.5,4.5 Z M6,12 L8.5,12 A1.5,1.5 0 0 1 10,13.5 L10,16 A1.5,1.5 0 0 1 8.5,17.5 L6,17.5 A1.5,1.5 0 0 1 4.5,16 L4.5,13.5 A1.5,1.5 0 0 1 6,12 Z M13.5,12 L16,12 A1.5,1.5 0 0 1 17.5,13.5 L17.5,16 A1.5,1.5 0 0 1 16,17.5 L13.5,17.5 A1.5,1.5 0 0 1 12,16 L12,13.5 A1.5,1.5 0 0 1 13.5,12 Z</Geometry>
    <Geometry x:Key="IconUpdates">M18,11 A7,7 0 1 1 15.4,5.6 M18,3.6 L18,7.6 L14,7.6</Geometry>
    <Geometry x:Key="IconSearch">M15,10 A5,5 0 1 1 5,10 A5,5 0 1 1 15,10 Z M13.8,13.8 L18.5,18.5</Geometry>
    <Geometry x:Key="IconSettings">M6,4 L6,6 M6,10 L6,18 M11,4 L11,12 M11,16 L11,18 M16,4 L16,8 M16,12 L16,18 M8,8 A2,2 0 1 1 4,8 A2,2 0 1 1 8,8 Z M13,14 A2,2 0 1 1 9,14 A2,2 0 1 1 13,14 Z M18,10 A2,2 0 1 1 14,10 A2,2 0 1 1 18,10 Z</Geometry>
    <Geometry x:Key="IconCar">M3,14 L5.2,9 L16.8,9 L19,14 L19,17 L3,17 Z M3,14 L19,14 M6,17 L6,18.6 M16,17 L16,18.6 M6.5,9 L7.6,6.5 L14.4,6.5 L15.5,9</Geometry>
    <Geometry x:Key="IconMap">M3,6 L8,4 L14,6 L19,4 L19,16 L14,18 L8,16 L3,18 Z M8,4 L8,16 M14,6 L14,18</Geometry>
    <Geometry x:Key="IconSound">M4,9 L7,9 L11,5 L11,17 L7,13 L4,13 Z M14,8 A4,4 0 0 1 14,14 M16.5,5.5 A7.5,7.5 0 0 1 16.5,16.5</Geometry>
    <Geometry x:Key="IconScript">M8,6 L3,11 L8,16 M14,6 L19,11 L14,16 M12.4,4.5 L9.6,17.5</Geometry>
    <Geometry x:Key="IconBox">M4,7 L11,3.5 L18,7 L18,15 L11,18.5 L4,15 Z M4,7 L11,10.5 L18,7 M11,10.5 L11,18.5</Geometry>
    <Geometry x:Key="IconSnow">M5.5,0.5 L5.5,10.5 M1,3 L10,8 M1,8 L10,3</Geometry>
    <Geometry x:Key="IconWarn">M11,3.5 L19.5,18 L2.5,18 Z M11,9 L11,12.8 M11,15.4 L11,15.5</Geometry>
    <Geometry x:Key="IconMin">M1,5.5 L10,5.5</Geometry>
    <Geometry x:Key="IconMax">M3,1 L8,1 A2,2 0 0 1 10,3 L10,8 A2,2 0 0 1 8,10 L3,10 A2,2 0 0 1 1,8 L1,3 A2,2 0 0 1 3,1 Z</Geometry>
    <Geometry x:Key="IconRestore">M3,3 L8,3 L8,10 L1,10 L1,3 Z M3,3 L3,1 L10,1 L10,8 L8,8</Geometry>
    <Geometry x:Key="IconClose">M1.5,1.5 L9.5,9.5 M9.5,1.5 L1.5,9.5</Geometry>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <!-- Стекло (DESIGN.md 3.2, доска «Гараж»): копия сцены с лёгким размытием и преломлением у краёв (PART_Lens),
         подложка, блик сверху слева, кромка-блик, контур 1 px и искры на кромке («Огоньки»). Кромку и искры
         окно считает под размер панели (Glass.cs). -->
    <Style TargetType="c:Glass">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Glass">
                    <Grid>
                        <!-- тень неподвижна: кэш, иначе размытие 56 px считалось бы заново на каждом кадре движущегося фона;
                             у светлого оформления своя, короткая и светлая (Palette.*.xaml, GlassShadow) -->
                        <!-- подложка тени — цвета окна текущего оформления: пока копия сцены ещё не готова (панель только выехала),
                             сквозь прозрачное светлое стекло виден не тёмный прямоугольник, а светлый (0.1.122: «панель тёмная, потом белая») -->
                        <Border x:Name="ShadowHost" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource WindowBack}"
                                Effect="{DynamicResource GlassShadow}">
                            <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                        </Border>
                        <Border x:Name="PART_Clip" ClipToBounds="True">
                            <Grid x:Name="PART_Lens">
                                <Border ClipToBounds="True">
                                    <Rectangle x:Name="PART_Sample" IsHitTestVisible="False"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Tint}"/>
                        <Border x:Name="PART_Highlight" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.3,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0"/>
                                    <GradientStop Color="#0AFFFFFF" Offset="0.34"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="PART_Contour" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1"
                                BorderBrush="#1FFFFFFF" IsHitTestVisible="False"/>
                        <!-- блик по кромке (векторы, под любой размер) и искры; кромка неподвижна — кэш картинкой -->
                        <Grid x:Name="PART_Deco" IsHitTestVisible="False">
                            <c:GlassEdge x:Name="PART_Edge" Corner="{Binding Corner, RelativeSource={RelativeSource TemplatedParent}}">
                                <c:GlassEdge.CacheMode><BitmapCache SnapsToDevicePixels="False"/></c:GlassEdge.CacheMode>
                            </c:GlassEdge>
                            <Canvas x:Name="PART_Sparks"/>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Shadow" Value="False">
                            <Setter TargetName="ShadowHost" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource FocusRing}" BorderThickness="3" CornerRadius="18" Margin="-2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт левой панели: иконка и подпись под ней (подпись видна всегда, DESIGN.md раздел 2) -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
        <!-- 10 и отступ 2: самая длинная подпись «Обновления» помещается в круглую каплю 68 × 64 (форма 4), не заходя на кромку -->
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Width" Value="70"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:NavGlyph Data="{TemplateBinding Tag}" Brush="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                        Active="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <TextBlock Text="{TemplateBinding Content}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Круглая кнопка в островке сверху (поиск, закрыть поиск): 38 × 38, значок из Tag, его размер — FontSize
         (у лупы 17, у крестика 11: значки нарисованы в разных сетках). Наведение — мягкая подложка, нажатие — 94 %. -->
    <Style x:Key="IslandButton" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="19" Background="Transparent">
                        <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SoftFill}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт фильтра в верхней панели: высота 30, активный белым 650 -->
    <Style x:Key="FilterItem" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"/>
                            <TextBlock Text="{Binding Count}" Opacity="0.7" FontWeight="SemiBold" Margin="5,0,0,0"
                                       Visibility="{Binding ShowCount, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главная кнопка: белая, тёмный текст, голубое свечение -->
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryInk}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- свечение у тёмного оформления, короткая тень у светлого (Palette.*.xaml, PrimaryGlow) -->
                    <Border CornerRadius="22" Background="{DynamicResource PrimaryBack}" Effect="{DynamicResource PrimaryGlow}">
                        <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                        </Trigger>
                        <!-- недоступная (ещё ничего не выбрано): тусклее, но на месте -->
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вторичная кнопка-таблетка в правой панели; нажатая сжимается до 97 % от центра, как главная (DESIGN.md 6) -->
    <Style x:Key="Secondary" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="19" Background="{DynamicResource SecBack}" BorderBrush="{DynamicResource SecRim}" BorderThickness="1" Padding="6,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SecHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource SecPress}"/>
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Текстовая ссылка («Отменить», «Понятно») -->
    <Style x:Key="Link" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="4,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Opacity" Value="0.8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Меню карточки (DESIGN_COMPONENTS 3.9): плашка 220, пункты 36 с радиусом 12, опасный внизу за линией -->
    <Style x:Key="CardMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- поле 16 под тень: окно меню прозрачное, тень рисуется внутри него -->
                    <Border Margin="16" Width="220" CornerRadius="16" Background="{DynamicResource MenuBack}" BorderBrush="{DynamicResource MenuRim}"
                            BorderThickness="1" Padding="6">
                        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#080C18" Opacity="0.35" RenderingBias="Performance"/></Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardMenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="B" CornerRadius="12" Background="Transparent" Padding="12,0">
                        <TextBlock Text="{TemplateBinding Header}" VerticalAlignment="Center" FontWeight="Medium"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource MenuHover}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardMenuLine" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{DynamicResource MenuLine}" Margin="8,5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка в капсуле окна: 44 × 36, сама прозрачная, подсветку даёт капля -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкая полоса прокрутки: светлый бегунок без кнопок -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="T" CornerRadius="4" Background="{DynamicResource Thumb}" Margin="2,0"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource ThumbHover}"/></Trigger>
                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource ThumbDrag}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плашка на фото карточки: «Есть обновление», «Страница пропала», «Выключен» -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Background" Value="#CC0A101E"/>
        <Setter Property="BorderBrush" Value="#38FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,12,12,0"/>
    </Style>

    <!-- ═════ Настройки (DESIGN.md 5.1, доски «Настройки: …») ═════ -->

    <!-- Заголовок группы: «Стекло», «Фон», «Движение» -->
    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Margin" Value="4,0,4,8"/>
    </Style>

    <!-- Тонкая полоса хода (проверка обновлений): дорожка и заполнение, без рамок и блеска стандартной -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource SoftFill}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource Ink}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Включатель без строки: подпись слева, дорожка 52 × 32 справа (панель «Проверка») -->
    <Style x:Key="MiniSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <c:GlassSwitch DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" OffBrush="{DynamicResource TrackOff}"
                                       IsOn="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                       Pressed="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поле ввода на стекле (ссылка в «Указать страницу»): таблетка, как поиск в верхней панели -->
    <Style x:Key="GlassField" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" CornerRadius="20" Background="{DynamicResource SoftFill}" BorderBrush="{DynamicResource SecRim}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Подсказка-страница в «Указать страницу»: строка с сайтом и названием; выбранная — светлее, с кромкой и свечением -->
    <Style x:Key="PickRow" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="16" BorderBrush="{DynamicResource SelGlow}" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                            <Border.Effect><BlurEffect Radius="18" RenderingBias="Performance"/></Border.Effect>
                        </Border>
                        <Border x:Name="B" CornerRadius="16" Background="{DynamicResource RowFill}" BorderBrush="{DynamicResource RowRim}" BorderThickness="1" Padding="14,10">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource RowFillHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource RowOn}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource RowOnRim}"/>
                            <Setter TargetName="B" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пояснение под группой и в строках -->
    <Style x:Key="Note" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <!-- Строка-включатель: вся строка нажимается, справа дорожка 52 × 32; недоступная тускнеет, но остаётся на месте -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row" CornerRadius="18" Background="{DynamicResource RowFill}" BorderBrush="{DynamicResource RowRim}" BorderThickness="1" Padding="16,12">
                        <DockPanel>
                            <c:GlassSwitch DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" OffBrush="{DynamicResource TrackOff}"
                                           IsOn="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                           Pressed="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Note}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RowFillHover}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка с выбором справа (сегменты, ползунок, счётчик): заголовок и пояснение слева -->
    <Style x:Key="OptionRow" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border CornerRadius="18" Background="{DynamicResource RowFill}" BorderBrush="{DynamicResource RowRim}" BorderThickness="1" Padding="16,12">
                        <!-- выбор справа; если подписи остаётся меньше 200 px — под подписью (иначе текст рвался по буквам) -->
                        <c:SideOrBelow Gap="16" MinText="200">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Note}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ContentPresenter/>
                        </c:SideOrBelow>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Сегменты: «Слабо | Средне | Сильно»; подложка и сами пункты -->
    <Style x:Key="SegmentBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="19"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource SetSegBack}"/>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="1,0">
                        <!-- свечение выбранного: 0 0 16px rgba(170,205,255,.22); размытая кромка, а не заливка — внутри пункт не синеет -->
                        <Border x:Name="Glow" CornerRadius="15" BorderBrush="{DynamicResource SelGlow}" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                            <Border.Effect><BlurEffect Radius="14" RenderingBias="Performance"/></Border.Effect>
                        </Border>
                        <Border x:Name="B" CornerRadius="15" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="13,5">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SegHover}"/></Trigger>
                        <!-- выбранный: светлее, с тонкой светлой кромкой и свечением (доска «Настройки») -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource SegOn}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SegOnRim}"/>
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.22"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плитка готового набора: название и что в нём; выбранная светлее, с белой кромкой -->
    <Style x:Key="PresetTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="16" BorderBrush="{DynamicResource SelGlow}" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                            <Border.Effect><BlurEffect Radius="18" RenderingBias="Performance"/></Border.Effect>
                        </Border>
                        <Border x:Name="B" CornerRadius="16" Background="{DynamicResource RowFill}" BorderBrush="{DynamicResource RowRim}" BorderThickness="1" Padding="14,9">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="{DynamicResource Ink2}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource RowFillHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource RowOn}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource RowOnRim}"/>
                            <Setter TargetName="B" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плитка темы фона: образец самой темы (основа и два пятна), подпись внизу; выбранная — с белой кромкой -->
    <Style x:Key="ThemeTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="76"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border CornerRadius="16" Background="{Binding Palette, Converter={StaticResource ThemeSwatch}, ConverterParameter=base}"/>
                        <Border CornerRadius="16" Background="{Binding Palette, Converter={StaticResource ThemeSwatch}, ConverterParameter=blob0}"/>
                        <Border CornerRadius="16" Background="{Binding Palette, Converter={StaticResource ThemeSwatch}, ConverterParameter=blob1}"/>
                        <Border CornerRadius="16" Background="{Binding Palette, Converter={StaticResource ThemeSwatch}, ConverterParameter=blob2}"/>
                        <Border CornerRadius="16" Background="{Binding Palette, Converter={StaticResource ThemeSwatch}, ConverterParameter=blob3}"/>
                        <Border CornerRadius="16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00080E1C" Offset="0.35"/>
                                    <GradientStop Color="#99080E1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,10,9">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border x:Name="Rim" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource TileRim}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rim" Property="BorderBrush" Value="{DynamicResource TileRimHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Rim" Property="BorderBrush" Value="{DynamicResource TileRimOn}"/>
                            <Setter TargetName="Rim" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт списка разделов настроек: таблетка 42 px, выбранный светлее и со свечением -->
    <Style x:Key="SettingsNav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="settingsNav"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="21" BorderBrush="{DynamicResource SelGlow}" BorderThickness="4" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Border.CacheMode>
                            <Border.Effect><BlurEffect Radius="18" RenderingBias="Performance"/></Border.Effect>
                        </Border>
                        <Border x:Name="B" CornerRadius="21" Background="Transparent" Padding="16,0">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource NavHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource NavOn}"/>
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.3"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Круглая кнопка счётчика «−» / «+» -->
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource Secondary}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="17" Background="{DynamicResource SecBack}" BorderBrush="{DynamicResource SecRim}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SecHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource SecPress}"/>
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пружина для подъёма карточки и наведения (DESIGN_MOTION 5): 0,5 с, упругость 0,15; длительность ×1,6 -->
    <m:SpringEase x:Key="Lift" Bounce="0.15"/>
    <m:SpringEase x:Key="Smooth" Bounce="0"/>
</ResourceDictionary>
